{
  "name": "tistory-blog-auto-v01",
  "version": "0.1.0",
  "description": "Tistory Blog draft, publish, and schedule automation desktop application",
  "author": "DS-8305",
  "private": true,
  "type": "module",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "pnpm run main:build && concurrently \"pnpm run dev\" \"pnpm run main:watch\" \"wait-on http://127.0.0.1:5173 dist-main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "main:build": "esbuild src/main/main.ts --bundle --platform=node --format=esm --external:electron --external:playwright --outfile=dist-main/main.js && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-main/preload.cjs",
    "main:watch": "concurrently \"esbuild src/main/main.ts --bundle --platform=node --format=esm --external:electron --external:playwright --outfile=dist-main/main.js --watch\" \"esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-main/preload.cjs --watch\"",
    "cli:build": "esbuild src/cli/draftCli.ts --bundle --platform=node --format=esm --external:playwright --external:google-auth-library --outfile=dist-cli/draftCli.js",
    "draft:login": "pnpm run cli:build && node dist-cli/draftCli.js login",
    "draft:verify": "pnpm run cli:build && node dist-cli/draftCli.js verify",
    "draft:run": "pnpm run cli:build && node dist-cli/draftCli.js run",
    "sheet:build": "esbuild src/cli/sheetNextCli.ts src/cli/profileSyncCli.ts src/cli/profilePrepareCli.ts src/cli/imageCollectCli.ts --bundle --platform=node --format=esm --external:google-auth-library --outdir=dist-cli",
    "image:collect": "pnpm run sheet:build && node dist-cli/imageCollectCli.js",
    "profile:prepare": "pnpm run sheet:build && node dist-cli/profilePrepareCli.js",
    "profile:sync": "pnpm run sheet:build && node dist-cli/profileSyncCli.js",
    "sheet:next": "pnpm run sheet:build && node dist-cli/sheetNextCli.js",
    "build": "tsc -p tsconfig.json --noEmit && pnpm run main:build && pnpm run cli:build && pnpm run sheet:build && vite build",
    "dist:portable": "pnpm run build && electron-builder --win portable --x64",
    "test": "vitest run --passWithNoTests",
    "test:browser": "cross-env TISTORY_BROWSER_TESTS=1 vitest run tests/automation/cdpLifecycle.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "google-auth-library": "11.0.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ds8305.tistoryblogv01",
    "productName": "Tistory Blog Automation",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Tistory-Blog-Automation-${version}-portable.${ext}"
    },
    "portable": {
      "unpackDirName": false,
      "useZip": true
    }
  }
}
